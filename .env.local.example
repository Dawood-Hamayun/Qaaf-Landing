# ----------------------------------------------------------------------
# Resend — newsletter signup + welcome email
# ----------------------------------------------------------------------
# 1. Sign up at https://resend.com (no credit card required)
# 2. Create an API key at https://resend.com/api-keys
#      Recommended permissions: Sending access + Audience access
# 3. Create an Audience at https://resend.com/audiences
#      Copy the Audience ID into RESEND_AUDIENCE_ID below
# 4. Verify a sender domain at https://resend.com/domains
#      Until verified, you can only send to your own signup email.
#      Set RESEND_FROM_EMAIL to a sender on the verified domain.
# ----------------------------------------------------------------------

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RESEND_FROM_EMAIL="Qaaf <hello@qaaf.app>"
